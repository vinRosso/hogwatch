# The hogwatch-zfs sidecar for Proxmox VE 8 hosts. Proxmox builds its own zfs
# userland to match its kernel module, so it comes from the Proxmox repository
# instead of Debian's. Proxmox publishes only amd64 packages: there is no arm64
# image for this tag.
FROM debian:12
# sha256 of the Proxmox release key, as fetched on 2026-11-02; a changed key fails the build.
ARG PVE_KEY_SHA256=13a87cec79f2d05f40f125629e4b509080a5c0286608bea273e36be9809ecaba
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-bookworm.gpg -o /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg \
 && { [ -z "${PVE_KEY_SHA256}" ] || echo "${PVE_KEY_SHA256}  /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg" | sha256sum -c -; } \
 && echo "deb http://download.proxmox.com/debian/pve bookworm pve-no-subscription" > /etc/apt/sources.list.d/pve.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zfsutils-linux \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /out && chown 10001:10001 /out
COPY write-zfs-tsv.sh entrypoint.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/write-zfs-tsv.sh /usr/local/bin/entrypoint.sh
ENV ZFS_OUT=/out/zfs.tsv ZFS_INTERVAL=300
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
HEALTHCHECK --interval=60s --timeout=5s --start-period=60s CMD ["/usr/local/bin/entrypoint.sh", "healthcheck"]
