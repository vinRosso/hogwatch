# The folder to analyze, as an absolute path on the host. Required.
SCAN_PATH=/storage

# Optional:
# Where Hogwatch keeps its database and the ZFS numbers (default: next to compose.yaml).
# DATA_PATH=./data
# ZFS_PATH=./zfs
# HOGWATCH_PORT=8080
# HOGWATCH_BASE_URL=https://hogwatch.example.com
# COMPOSE_PROFILES=zfs
# ZFS_READER_TAG=debian-13
