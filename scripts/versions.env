# Toolchain versions: the single source for scripts/dev-setup.sh, the Makefile
# and CI. KEY=value only, no inline comments (make keeps trailing text).
#
# Go: latest stable from https://go.dev/dl/?mode=json (go.mod keeps the 1.25.0 floor).
GO_VERSION=1.27.3
# Node: latest v24 LTS from https://nodejs.org/dist/index.json (build-time only).
NODE_VERSION=24.22.1
# Go language floor: the `go` line of the root go.mod. make lint fails if it differs.
GO_FLOOR=1.25.0
